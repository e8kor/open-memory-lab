{
  "name": "open-memory-lab-sdk",
  "version": "0.7.1",
  "description": "TypeScript client for the Open Memory Lab HTTP API: types generated from openapi.yaml, openapi-fetch, and a thin hand-written wrapper.",
  "license": "Apache-2.0",
  "author": "e8kor",
  "homepage": "https://e8kor.github.io/open-memory-lab/engineering/sdks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e8kor/open-memory-lab.git",
    "directory": "sdks/typescript"
  },
  "bugs": {
    "url": "https://github.com/e8kor/open-memory-lab/issues"
  },
  "keywords": [
    "memory",
    "agents",
    "mcp",
    "open-memory-lab",
    "sdk"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\""
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
