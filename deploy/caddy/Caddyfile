# Open Memory Lab — the path router in front of the lead and oml-web
# (ADR-0070 d4). One public origin, because the session cookie is a
# __Host- cookie the browser sends to one host only.
#
#   - each page oml-web serves (oml_web::PAGES in
#     crates/clients/oml-web/src/lib.rs) goes to oml-web, 127.0.0.1:8091;
#   - every other path goes to the lead, 127.0.0.1:8090: the API (/v1, /v2),
#     /mcp, /oauth, /.well-known, /readyz, sign-in (/web/sign-in,
#     /web/callback/*, /web/sign-up) and sign-out (POST /web); an old page
#     URL of v0.6 reaches it too and is not found there (v0.7.1).
#
# A landing page is not part of this repository's releases (ADR-0070 d12):
# a deployment that serves one adds its own static block here.
#
# oml-web reaches the lead at its own address (web.api_url), never back
# through this proxy. docker-compose.yml and `oml quickstart` route the same
# set with the service names in place of the addresses; the routes grow as
# pages move, and crates/clients/oml-web/tests/routes.rs holds every copy to
# PAGES.

memory.example.com {
	@oml_web path /web/guardrails /web/workareas /web/admin/workareas /web/memories /web/atlas /web/admin/memories /web/admin/atlas /web/data/memories /web/admin/data/memories /web/review /web/admin/review /web/keys /web/admin/keys /web/memory /web/admin/memory /web/admin/curate /web/start /web/start/status /web/start/export /web/setup /web/admin/people /web/admin/users /web/render/* /web/assets/*
	reverse_proxy @oml_web 127.0.0.1:8091

	reverse_proxy 127.0.0.1:8090
}
